fn choose_index(best: i32, candidate: i32, k: i32, replace: bool) -> i32
requires k > 0 && best >= 0 && best < k && candidate >= 0 && candidate < k
ensures return >= 0 && return < k {
  if replace {
    return candidate;
  }
  return best;
}

fn buffer_index(row: i64, d: i64) -> i64
requires row >= 0 && row < 2147483647 && d >= 0 && d < 128
ensures return >= 0 && return < 274877906816 {
  return row * 128 + d;
}

fn nonempty_count(count: i32) -> i32
requires count > 0
ensures return > 0 {
  return count;
}

fn main() -> i32 {
  return choose_index(0, 2, 4, true);
}
