FROM vxvector-postgres:17-dev AS builder
WORKDIR /opt/vxvector-src
COPY src/ src/
COPY include/ include/
COPY build/linux/kmeans.o build/linux/kmeans.o
RUN mkdir -p /opt/vxvector \
    && cc -O2 -fPIC -I include -c src/data_path.c -o /opt/vxvector/data_path.o \
    && cc -shared -Wl,--no-undefined build/linux/kmeans.o /opt/vxvector/data_path.o -lm -o /opt/vxvector/libvxvector_kmeans.so \
    && cc -O2 -Wall -Wextra -Werror -I include src/worker.c -L /opt/vxvector \
       -lvxvector_kmeans -Wl,-rpath,'$ORIGIN' -o /opt/vxvector/vxvector-worker

FROM vxvector-postgres:17-dev AS runtime
COPY --from=builder /opt/vxvector/vxvector-worker /opt/vxvector/libvxvector_kmeans.so /usr/local/libexec/vxvector/
COPY build/linux/libpg_vxvector.so /usr/lib/postgresql/17/lib/pg_vxvector.so
COPY build/linux/vx-build-info.json vx-revision.txt /usr/local/libexec/vxvector/
COPY pg_vxvector/pg_vxvector.control pg_vxvector/sql/pg_vxvector--0.1.0.sql /usr/share/postgresql/17/extension/
COPY docker/020-vxvector.sql /docker-entrypoint-initdb.d/
