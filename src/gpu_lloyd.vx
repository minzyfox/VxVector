// NVIDIA Lloyd kernels. The caller supplies device-resident buffers and
// launches assignment, update, and copy once per iteration.
import core::convert;
import core::num;

pub fn vxvector_gpu_assign_v1(points: &Tensor<f32, [?, ?], Memory::HBM>,
  rows: i32, dims: i32, k: i32, metric: i32,
  centers: &Tensor<f32, [?, ?], Memory::HBM>,
  labels: &mut Tensor<i32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for row in 0..rows across blocks {
      let mut best = 0;
      let mut best_distance: f64 = 0.0;
      for center in 0..k {
        let mut squared: f64 = 0.0;
        let mut dot: f64 = 0.0;
        let mut point_norm: f64 = 0.0;
        let mut center_norm: f64 = 0.0;
        for d in 0..dims {
          let left = f64::from(points[row][d]);
          let right = f64::from(centers[center][d]);
          let difference = left - right;
          squared += difference * difference;
          dot += left * right;
          point_norm += left * left;
          center_norm += right * right;
        }
        let mut score: f64 = squared;
        if metric == 1 {
          score = -dot;
        }
        if metric == 2 {
          score = 1.0;
          if point_norm == 0.0 && center_norm == 0.0 {
            score = 0.0;
          }
          if point_norm > 0.0 && center_norm > 0.0 {
            score = 1.0 - dot / (point_norm * center_norm).sqrt();
          }
        }
        if center == 0 || score < best_distance {
          best = center;
          best_distance = score;
        }
      }
      labels[row] = best;
    }
  }
  return;
}

pub fn vxvector_gpu_update_v1(points: &Tensor<f32, [?, ?], Memory::HBM>,
  rows: i32, dims: i32, k: i32, iteration: i32, spherical: i32,
  labels: &Tensor<i32, [?], Memory::HBM>,
  updated: &mut Tensor<f32, [?, ?], Memory::HBM>,
  errors: &mut Tensor<i32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for center in 0..k across blocks {
      let mut count = 0;
      let mut error = 0;
      for row in 0..rows {
        if labels[row] == center {
          count += 1;
        }
      }
      for d in 0..dims {
        if count == 0 {
          let replacement = ((i64::from(center) + i64::from(iteration)) %
            i64::from(rows)) as i32;
          updated[center][d] = points[replacement][d];
        } else {
          let mut sum: f32 = 0.0;
          for row in 0..rows {
            if labels[row] == center {
              if error == 0 {
                let total = sum + points[row][d];
                if total > 3.40282347e+38 || total < -3.40282347e+38 {
                  error = 1;
                } else {
                  sum = total;
                }
              }
            }
          }
          updated[center][d] = sum / (count as f32);
        }
      }
      if spherical != 0 {
        let mut squared: f64 = 0.0;
        for d in 0..dims {
          let value = f64::from(updated[center][d]);
          squared += value * value;
        }
        if squared > 0.0 {
          let norm = squared.sqrt();
          for d in 0..dims {
            updated[center][d] = (f64::from(updated[center][d]) / norm) as f32;
          }
        }
      }
      errors[center] = error;
    }
  }
  return;
}

pub fn vxvector_gpu_copy_v1(k: i32, dims: i32,
  centers: &mut Tensor<f32, [?, ?], Memory::HBM>,
  updated: &Tensor<f32, [?, ?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for center in 0..k across blocks {
      for d in 0..dims {
        centers[center][d] = updated[center][d];
      }
    }
  }
  return;
}
