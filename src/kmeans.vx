// Standalone k-means over row-major float32 arrays.
// The caller owns every buffer. See include/vextor_kmeans.h for capacities.
import core::convert;
import core::num;
import core::ptr;

enum DistanceMetric {
  L2,
  InnerProduct,
  Cosine,
}

// The foreign caller supplies allocation sizes and disjoint work buffers.
unsafe fn copy_vector(destination: *mut f32, source: *const f32, length: i64) -> void
requires valid(destination, length)
requires valid(source, length)
requires initialized(source, length)
requires !overlaps(destination, source, length)
{
  for i in 0i64..length {
    unsafe { destination[i] = source[i]; }
  }
}

fn greatest_common_divisor(left: i32, right: i32) -> i32 {
  let mut a = left;
  let mut b = right;
  while b != 0 {
    let remainder = a % b;
    a = b;
    b = remainder;
  }
  return a;
}

fn sample_row(position: i32, rows: i32, offset: i32, stride: i32) -> i32 {
  let index = i64::from(offset) + i64::from(position) * i64::from(stride);
  return (index % i64::from(rows)) as i32;
}

unsafe fn distance(left: *const f32, right: *const f32,
dims: i32, metric: &DistanceMetric) -> f64
requires valid(left, dims)
requires valid(right, dims)
requires initialized(left, dims)
requires initialized(right, dims)
{
  match metric {
    DistanceMetric::L2 => {
      let mut squared: f64 = 0.0;
      for d in 0..dims {
        let difference = f64::from(unsafe { left[d] }) - f64::from(unsafe {
          right[d]
        });
        squared += difference * difference;
      }
      return squared;
    },
    DistanceMetric::InnerProduct => {
      let mut dot: f64 = 0.0;
      for d in 0..dims {
        dot += f64::from(unsafe { left[d] }) * f64::from(unsafe { right[d] });
      }
      return -dot;
    },
    DistanceMetric::Cosine => {
      let mut dot: f64 = 0.0;
      let mut left_norm: f64 = 0.0;
      let mut right_norm: f64 = 0.0;
      for d in 0..dims {
        let left_wide = f64::from(unsafe { left[d] });
        let right_wide = f64::from(unsafe { right[d] });
        dot += left_wide * right_wide;
        left_norm += left_wide * left_wide;
        right_norm += right_wide * right_wide;
      }
      if left_norm == 0.0 && right_norm == 0.0 {
        return 0.0;
      }
      if left_norm == 0.0 || right_norm == 0.0 {
        return 1.0;
      }
      return 1.0 - dot / (left_norm * right_norm).sqrt();
    },
  }
}

fn nearest(data: *const f32, data_offset: i64, row: i32,
centers: *const f32, center_offset: i64,
k: i32, dims: i32, metric: &DistanceMetric) -> i32
requires k > 0
ensures return >= 0 && return < k
{
  let point = offset(data, data_offset + i64::from(row) * i64::from(dims));
  let mut best = 0;
  let mut best_distance = unsafe {
    distance(point, offset(centers, center_offset), dims, metric)
  };
  for center in 1..k invariant best >= 0 && best < k {
    let candidate = unsafe { distance(point,
      offset(centers, center_offset + i64::from(center) * i64::from(dims)), dims, metric) };
    if candidate < best_distance {
      best = center;
      best_distance = candidate;
    }
  }
  return best;
}

unsafe fn normalize(vector: *mut f32, dims: i32) -> void
requires valid(vector, dims)
requires initialized(vector, dims)
{
  let mut squared: f64 = 0.0;
  for d in 0..dims {
    let wide = f64::from(unsafe { vector[d] });
    squared += wide * wide;
  }
  if squared > 0.0 {
    let norm = squared.sqrt();
    for d in 0..dims {
      unsafe { vector[d] = (f64::from(vector[d]) / norm) as f32; }
    }
  }
}

// i32 dimensions keep the widened row-major arithmetic within i64.
fn buffer_index(row: i64, rows: i64, dims: i64, d: i64) -> i64
requires rows > 0 && rows <= 2147483647 && dims > 0 && dims <= 2147483647
requires row >= 0 && row < rows && d >= 0 && d < dims
ensures return >= 0 && return < rows * dims
{
  return row * dims + d;
}

// The foreign caller owns initialized counts[k] and sums[k * dims] buffers.
unsafe fn accumulate_point(point: *const f32, sums: *mut f32, counts: *mut i32,
center: i32, k: i32, dims: i32) -> i32
requires k > 0
requires dims > 0
requires center >= 0
requires center < k
requires valid(point, dims)
requires initialized(point, dims)
requires valid(counts, k)
requires initialized(counts, k)
requires valid(sums, (k as i64) * (dims as i64))
requires initialized(sums, (k as i64) * (dims as i64))
{
  unsafe { counts[center] = counts[center] + 1; }
  for d in 0..dims {
    let index = buffer_index(i64::from(center), i64::from(k), i64::from(dims), i64::from(d));
    let value = unsafe { point[d] };
    let total = unsafe { sums[index] + value };
    if !total.is_finite() {
      return 1;
    }
    unsafe { sums[index] = total; }
  }
  return 0;
}

fn train(data: *const f32, data_offset: i64, rows: i32, dims: i32,
k: i32, sampling_factor: i32, batch_size: i32,
iterations: i32, restarts: i32, metric: &DistanceMetric, spherical: i32,
seed: i32, output: *mut f32, output_offset: i64,
assignments: *mut i32, write_assignments: i32,
current: *mut f32, sums: *mut f32, counts: *mut i32) -> i32
requires k > 0 && dims > 0
{
  let requested = i64::from(k) * i64::from(sampling_factor);
  let mut samples = rows;
  if requested < i64::from(rows) {
    samples = requested as i32;
  }
  let mut has_best = false;
  let mut best_objective: f64 = 0.0;
  let offset = (i64::from(seed) % i64::from(rows)) as i32;
  let mut stride = 1;
  if rows > 1 {
    stride = (1 + ((i64::from(seed) * 48271) % i64::from(rows - 1))) as i32;
    while greatest_common_divisor(stride, rows) != 1 {
      stride += 1;
      if stride >= rows {
        stride = 1;
      }
    }
  }

  for restart in 0..restarts {
    for center in 0..k {
      let position = ((i64::from(center) * i64::from(samples) / i64::from(k)
      + i64::from(restart) * 104729) % i64::from(samples)) as i32;
      let row = sample_row(position, rows, offset, stride);
      unsafe { copy_vector(offset_mut(current, i64::from(center) * i64::from(dims)),
        offset(data, data_offset + i64::from(row) * i64::from(dims)), i64::from(dims)); }
      if spherical != 0 {
        unsafe {
          normalize(offset_mut(current, i64::from(center) * i64::from(dims)), dims);
        }
      }
    }

    for iteration in 0..iterations {
      for center in 0..k {
        unsafe { counts[center] = 0; }
        for d in 0..dims {
          unsafe {
            sums[buffer_index(i64::from(center), i64::from(k), i64::from(dims), i64::from(d))] = 0.0;
          }
        }
      }

      let mut batch_start = 0;
      while batch_start < samples {
        let mut batch_end = samples;
        if batch_size < samples - batch_start {
          batch_end = batch_start + batch_size;
        }
        for position in batch_start..batch_end {
          let row = sample_row(position, rows, offset, stride);
          let center = nearest(data, data_offset, row, current as *const f32, 0,
          k, dims, metric);
          let point = offset(data, data_offset + i64::from(row) * i64::from(dims));
          let accumulation = unsafe {
            accumulate_point(point, sums, counts, center, k, dims)
          };
          if accumulation != 0 {
            return accumulation;
          }
        }
        batch_start = batch_end;
      }

      for center in 0..k {
        let count = unsafe { counts[center] };
        if count == 0 {
          let position = ((i64::from(center) + i64::from(iteration)) % i64::from(samples)) as i32;
          let row = sample_row(position, rows, offset, stride);
          unsafe { copy_vector(offset_mut(current, i64::from(center) * i64::from(dims)),
            offset(data, data_offset + i64::from(row) * i64::from(dims)), i64::from(dims)); }
        } else {
          for d in 0..dims {
            let index = buffer_index(i64::from(center), i64::from(k), i64::from(dims), i64::from(d));
            unsafe { current[index] = sums[index] / (count as f32); }
          }
        }
        if spherical != 0 {
          unsafe {
            normalize(offset_mut(current, i64::from(center) * i64::from(dims)), dims);
          }
        }
      }
    }

    let mut objective: f64 = 0.0;
    for position in 0..samples {
      let row = sample_row(position, rows, offset, stride);
      let center = nearest(data, data_offset, row, current as *const f32, 0,
      k, dims, metric);
      objective += unsafe { distance(offset(data, data_offset + i64::from(row) * i64::from(dims)),
        offset(current as *const f32, i64::from(center) * i64::from(dims)), dims, metric) };
    }
    if !has_best || objective < best_objective {
      has_best = true;
      best_objective = objective;
      unsafe { copy_vector(offset_mut(output, output_offset), current as *const f32,
        i64::from(k) * i64::from(dims)); }
    }
  }

  if write_assignments != 0 {
    for row in 0..rows {
      let center = nearest(data, data_offset, row,
      output as *const f32, output_offset, k, dims, metric);
      unsafe { assignments[row] = center; }
    }
  }
  return 0;
}

// metric: 0=l2, 1=inner product, 2=cosine. root_count=0 means flat clustering.
// nodes contains the zero root, optional root centroids, then leaf centroids.
// Returns 1 for invalid arguments or float32 centroid-sum overflow.
pub fn vextor_kmeans_v1(points: *const f32, rows: i32, dims: i32,
root_count: i32, leaf_count: i32,
sampling_factor: i32, batch_size: i32,
iterations: i32, restarts: i32, metric: i32,
spherical: i32, seed: i32,
nodes: *mut f32, parents: *mut i32,
assignments: *mut i32, current: *mut f32,
sums: *mut f32, counts: *mut i32) -> i32 {
  if leaf_count <= 0 || dims <= 0 {
    return 1;
  }
  if points == null<f32>() || nodes == null_mut<f32>() ||
  parents == null_mut<i32>() || assignments == null_mut<i32>() ||
  current == null_mut<f32>() || sums == null_mut<f32>() ||
  counts == null_mut<i32>() ||
  rows <= 0 || leaf_count > rows ||
  root_count < 0 || root_count > leaf_count ||
  i64::from(root_count) + i64::from(leaf_count) >= 2147483647 ||
  sampling_factor <= 0 || batch_size <= 0 || iterations <= 0 ||
  restarts <= 0 || metric < 0 || metric > 2 || seed < 0 {
    return 1;
  }
  for row in 0..rows {
    for d in 0..dims {
      let value = unsafe {
        points[i64::from(row) * i64::from(dims) + i64::from(d)]
      };
      if !value.is_finite() {
        return 1;
      }
    }
  }
  for d in 0..dims {
    unsafe { nodes[d] = 0.0; }
  }
  unsafe { parents[0] = -1; }

  let distance_metric = match metric {
    0 => {
      DistanceMetric::L2
    },
    1 => {
      DistanceMetric::InnerProduct
    },
    _ => {
      DistanceMetric::Cosine
    },
  };
  let leaf_offset = i64::from(1 + root_count) * i64::from(dims);
  let leaf_status = train(points, 0, rows, dims, leaf_count, sampling_factor, batch_size,
  iterations, restarts, &distance_metric, spherical, seed, nodes, leaf_offset,
  assignments, 1, current, sums, counts);
  if leaf_status != 0 {
    return leaf_status;
  }

  if root_count > 0 {
    let root_status = train(nodes as *const f32, leaf_offset, leaf_count, dims, root_count,
    sampling_factor, batch_size, iterations, restarts, &distance_metric, spherical,
    (seed % 2147483646) + 1, nodes, i64::from(dims),
    assignments, 0, current, sums, counts);
    if root_status != 0 {
      return root_status;
    }
    for root in 0..root_count {
      unsafe { parents[1 + root] = 0; }
    }
  }
  for leaf in 0..leaf_count {
    let mut parent = 0;
    if root_count > 0 {
      let center = nearest(nodes as *const f32, leaf_offset, leaf,
      nodes as *const f32, i64::from(dims), root_count, dims, &distance_metric);
      parent = 1 + center;
    }
    unsafe { parents[1 + root_count + leaf] = parent; }
  }
  return 0;
}
