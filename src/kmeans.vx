// K-means over row-major float32 arrays, and the streaming data path that
// collects its sample. The caller owns every buffer. See
// include/vxvector_kmeans.h and include/vxvector_data_path.h for capacities.
//
// Each internal function that reads or writes through a raw pointer is an
// `unsafe fn` whose `requires` state the capacities it needs. The checker proves
// those clauses at each call inside this file. Only the C boundaries,
// vxvector_kmeans_v2, vxvector_plan_cpu_reason_v1 and vxvector_run_cpu_reason_v1,
// trust their callers. `vxc --audit` lists what is trusted.
//
// Pointer offsets below are products of i64 locals, such as `c * width`. The
// pointer checker of Vx main tracks such an offset, but not one that contains a
// call such as `i64::from(c) * width`, and it drops a fact when a variable that
// the fact names goes out of scope. So the loops whose facts matter count with
// i64 locals that stay in scope.
//
// This object needs nothing from the Vx runtime library. The PostgreSQL
// extension links it for vxvector_plan_cpu_reason_v1, and src/data_path.c passes
// in the clock, so that it stays that way.
import core::convert;
import core::num;
import core::ptr;

enum DistanceMetric {
  L2,
  InnerProduct,
  Cosine,
}

// The foreign caller supplies allocation sizes and disjoint work buffers.
unsafe fn copy_vector(destination: *mut f32, source: *const f32, length: i64) -> void
requires valid(destination, length)
requires valid(source, length)
requires initialized(source, length)
requires !overlaps(destination, source, length)
ensures initialized(destination, length)
{
  for i in 0i64..length invariant initialized(destination, i) {
    unsafe { destination[i] = source[i]; }
  }
}

unsafe fn zero_counts(counts: *mut i32, k: i32) -> void
requires k > 0
requires valid(counts, k)
ensures initialized(counts, k)
{
  for c in 0..k invariant initialized(counts, c) {
    unsafe { counts[c] = 0; }
  }
}

unsafe fn zero_sums(sums: *mut f32, size: i64) -> void
requires size > 0i64
requires valid(sums, size)
ensures initialized(sums, size)
{
  for i in 0i64..size invariant initialized(sums, i) {
    unsafe { sums[i] = 0.0; }
  }
}

// i32 dimensions keep the widened row-major arithmetic within i64.
fn buffer_index(row: i64, rows: i64, dims: i64, d: i64) -> i64
requires rows > 0 && rows <= 2147483647 && dims > 0 && dims <= 2147483647
requires row >= 0 && row < rows && d >= 0 && d < dims
ensures return >= 0 && return < rows * dims
{
  return row * dims + d;
}

// ---------------------------------------------------------------------------
// Sampling. One sampler chooses the training rows for the array API and for
// the streaming data path, so both train on the same rows for the same seed.

// An empty slot of the sampler's table. Row indices are never negative.
const EMPTY_SLOT: i64 = -1;

// One SplitMix64 output and the state that follows it.
struct Draw {
  value: u64,
  state: u64,
}

// SplitMix64 (Steele, Lea and Flood, 2014) defines the seed sequence
// independently of the platform C library. Vx has no hexadecimal literals: the
// constants are 0x9e3779b97f4a7c15, 0xbf58476d1ce4e5b9 and 0x94d049bb133111eb.
fn splitmix64(state: u64) -> Draw {
  let golden: u64 = 11400714819323198485;
  let first: u64 = 13787848793156543929;
  let second: u64 = 10723151780598845931;
  let shift_first: u64 = 30;
  let shift_second: u64 = 27;
  let shift_last: u64 = 31;
  let next = state.wrapping_add(golden);
  let mut z = next;
  z = (z ^ (z >> shift_first)).wrapping_mul(first);
  z = (z ^ (z >> shift_second)).wrapping_mul(second);
  return Draw { value: z ^ (z >> shift_last), state: next };
}

// A uniform value below bound. Rejecting values below 2^64 mod bound removes
// the bias of the remainder.
fn random_below(state: u64, bound: u64) -> Draw
requires bound > 0
{
  let zero: u64 = 0;
  let threshold = zero.wrapping_sub(bound) % bound;
  let mut draw = splitmix64(state);
  while draw.value < threshold {
    draw = splitmix64(draw.state);
  }
  return Draw { value: draw.value % bound, state: draw.state };
}

// The sampler's table size: the smallest power of two that is at least twice
// count, so that at most half of the slots are full.
fn table_slots(count: i64) -> i64
requires count > 0 && count <= 2147483647
ensures return > count
{
  let mut slots = 1i64;
  while slots < 2i64 * count invariant slots >= 1i64 && slots < 4i64 * count {
    slots = slots * 2i64;
  }
  return slots;
}

// The first slot to probe for row. The golden-ratio multiplier spreads
// neighboring rows over the table. With a power-of-two slots, the remainder
// keeps the low bits of the product.
fn first_slot(row: i64, slots: i64) -> i64
requires slots > 0
ensures return >= 0 && return < slots
{
  let golden: u64 = 11400714819323198485;
  let slot = ((row as u64).wrapping_mul(golden) % (slots as u64)) as i64;
  // The remainder is below slots. The prover does not follow the conversions
  // to and from u64, so this check states the bound.
  if slot < 0 || slot >= slots {
    return 0;
  }
  return slot;
}

// The slot that holds row, or else the empty slot where row belongs. The
// table must have an empty slot.
unsafe fn find_slot(table: *const i64, slots: i64, row: i64) -> i64
requires slots > 0
requires valid(table, slots)
requires initialized(table, slots)
ensures return >= 0 && return < slots
ensures !frees(table)
{
  let mut slot = first_slot(row, slots);
  let mut value: i64 = unsafe { table[slot] };
  while value != EMPTY_SLOT && value != row invariant slot >= 0 && slot < slots {
    slot = slot + 1;
    if slot == slots {
      slot = 0;
    }
    value = unsafe { table[slot] };
  }
  return slot;
}

// Floyd's algorithm chooses count distinct rows of 0..rows with O(count)
// storage, and writes them to chosen in the order of selection. table is
// scratch with more slots than count.
unsafe fn select_rows(rows: i64, count: i64, seed: u64, table: *mut i64, slots: i64,
chosen: *mut i64) -> void
requires count > 0 && count <= rows && slots > count
requires valid(table, slots)
requires valid(chosen, count)
ensures initialized(chosen, count)
ensures !frees(table)
ensures !frees(chosen)
{
  for i in 0i64..slots invariant initialized(table, i) {
    unsafe { table[i] = EMPTY_SLOT; }
  }
  let mut state = seed;
  for i in 0i64..count
  invariant initialized(table, slots)
  invariant initialized(chosen, i) {
    // Step i draws from 0..=last. A row drawn before is replaced by last,
    // which no earlier step could draw.
    let last: i64 = rows - count + i;
    let draw = random_below(state, (last + 1i64) as u64);
    state = draw.state;
    let mut row: i64 = draw.value as i64;
    let mut slot: i64 = unsafe { find_slot(table as *const i64, slots, row) };
    if unsafe { table[slot] } != EMPTY_SLOT {
      row = last;
      slot = unsafe { find_slot(table as *const i64, slots, row) };
    }
    unsafe { table[slot] = row; }
    unsafe { chosen[i] = row; }
  }
}

// The training rows of rows rows: every row in order when samples is all of
// them, and Floyd's selection otherwise. Floyd's selection of every row also
// gives them in order, so the first case only skips the table. The kernel and
// the data path both choose this way.
unsafe fn choose_rows(rows: i64, samples: i64, seed: u64, table: *mut i64, slots: i64,
chosen: *mut i64) -> void
requires samples > 0 && samples <= rows && slots > samples
requires valid(table, slots)
requires valid(chosen, samples)
ensures initialized(chosen, samples)
ensures !frees(table)
ensures !frees(chosen)
{
  if samples == rows {
    for i in 0i64..samples invariant initialized(chosen, i) {
      unsafe { chosen[i] = i; }
    }
    return;
  }
  unsafe { select_rows(rows, samples, seed, table, slots, chosen); }
}

// The row of data at sample position position.
unsafe fn sample_row(chosen: *const i64, samples: i32, position: i32, rows: i32) -> i64
requires samples > 0 && position >= 0 && position < samples && rows > 0
requires valid(chosen, samples)
requires initialized(chosen, samples)
ensures return >= 0i64 && return < (rows as i64)
{
  let row: i64 = unsafe { chosen[position] };
  // choose_rows writes rows below rows. The prover cannot see what memory
  // holds, so this check states the bound.
  if row < 0i64 || row >= (rows as i64) {
    return 0i64;
  }
  return row;
}

// Spreads centers 0..k evenly over positions 0..samples, shifted by shift.
fn spaced_position(center: i64, k: i32, samples: i32, shift: i64) -> i32
requires k > 0 && samples > 0 && center >= 0i64 && shift >= 0i64
ensures return >= 0 && return < samples
{
  let spread = center * i64::from(samples) / i64::from(k);
  let r = (spread + shift) % i64::from(samples);
  // The prover does not model `/`, so it cannot see that spread >= 0. For a
  // spread >= 0, this line returns r unchanged.
  return ((r + i64::from(samples)) % i64::from(samples)) as i32;
}

// ---------------------------------------------------------------------------
// Lloyd's algorithm.

unsafe fn distance(left: *const f32, right: *const f32,
dims: i32, metric: &DistanceMetric) -> f64
requires valid(left, dims)
requires valid(right, dims)
requires initialized(left, dims)
requires initialized(right, dims)
{
  match metric {
    DistanceMetric::L2 => {
      let mut squared: f64 = 0.0;
      for d in 0..dims {
        let difference = f64::from(unsafe { left[d] }) - f64::from(unsafe {
          right[d]
        });
        squared += difference * difference;
      }
      return squared;
    },
    DistanceMetric::InnerProduct => {
      let mut dot: f64 = 0.0;
      for d in 0..dims {
        dot += f64::from(unsafe { left[d] }) * f64::from(unsafe { right[d] });
      }
      return -dot;
    },
    DistanceMetric::Cosine => {
      let mut dot: f64 = 0.0;
      let mut left_norm: f64 = 0.0;
      let mut right_norm: f64 = 0.0;
      for d in 0..dims {
        let left_wide = f64::from(unsafe { left[d] });
        let right_wide = f64::from(unsafe { right[d] });
        dot += left_wide * right_wide;
        left_norm += left_wide * left_wide;
        right_norm += right_wide * right_wide;
      }
      if left_norm == 0.0 && right_norm == 0.0 {
        return 0.0;
      }
      if left_norm == 0.0 || right_norm == 0.0 {
        return 1.0;
      }
      return 1.0 - dot / (left_norm * right_norm).sqrt();
    },
  }
}

// Returns the index of the centroid nearest to point. centers holds k
// row-major centroids.
unsafe fn nearest(point: *const f32, centers: *const f32,
k: i32, dims: i32, metric: &DistanceMetric) -> i32
requires k > 0 && dims > 0
requires valid(point, dims)
requires initialized(point, dims)
requires valid(centers, (k as i64) * (dims as i64))
requires initialized(centers, (k as i64) * (dims as i64))
ensures return >= 0 && return < k
{
  let width = i64::from(dims);
  let mut best = 0;
  let mut best_distance = unsafe { distance(point, centers, dims, metric) };
  for center in 1..k invariant best >= 0 && best < k {
    let c: i64 = i64::from(center);
    let candidate: f64 = unsafe { distance(point, offset(centers, c * width), dims, metric) };
    if candidate < best_distance {
      best = center;
      best_distance = candidate;
    }
  }
  return best;
}

// The distance from point to centroid center of the k row-major centers.
unsafe fn centroid_distance(point: *const f32, centers: *const f32, center: i32,
k: i32, dims: i32, metric: &DistanceMetric) -> f64
requires k > 0 && dims > 0 && center >= 0 && center < k
requires valid(point, dims)
requires initialized(point, dims)
requires valid(centers, (k as i64) * (dims as i64))
requires initialized(centers, (k as i64) * (dims as i64))
{
  let c: i64 = i64::from(center);
  let width: i64 = i64::from(dims);
  return unsafe { distance(point, offset(centers, c * width), dims, metric) };
}

// A float comparison as a branch condition crashes the prover: it sends `0.0`
// to z3 in integer logic (vx-lang/Vx#3145, open on 423a10db). A call keeps
// the comparison out of the facts.
fn positive(value: f64) -> bool {
  return value > 0.0;
}

unsafe fn normalize(vector: *mut f32, dims: i32) -> void
requires valid(vector, dims)
requires initialized(vector, dims)
{
  let mut squared: f64 = 0.0;
  for d in 0..dims {
    let wide = f64::from(unsafe { vector[d] });
    squared += wide * wide;
  }
  if positive(squared) {
    let norm = squared.sqrt();
    for d in 0..dims {
      unsafe { vector[d] = (f64::from(vector[d]) / norm) as f32; }
    }
  }
}

// Adds point to the sum of centroid center, and counts it.
unsafe fn accumulate_point(point: *const f32, sums: *mut f32, counts: *mut i32,
center: i32, k: i32, dims: i32) -> i32
requires k > 0
requires dims > 0
requires center >= 0
requires center < k
requires valid(point, dims)
requires initialized(point, dims)
requires valid(counts, k)
requires initialized(counts, k)
requires valid(sums, (k as i64) * (dims as i64))
requires initialized(sums, (k as i64) * (dims as i64))
{
  unsafe { counts[center] = counts[center] + 1; }
  for d in 0..dims {
    let index = buffer_index(i64::from(center), i64::from(k), i64::from(dims), i64::from(d));
    let value = unsafe { point[d] };
    let total = unsafe { sums[index] + value };
    if !total.is_finite() {
      return 1;
    }
    unsafe { sums[index] = total; }
  }
  return 0;
}

// The sum of the distances from the sampled rows of data to their nearest of
// the k centers.
unsafe fn sample_objective(data: *const f32, rows: i32, dims: i32, k: i32,
samples: i32, chosen: *const i64, metric: &DistanceMetric,
centers: *const f32) -> f64
requires k > 0 && dims > 0 && rows > 0 && samples > 0
requires valid(data, (rows as i64) * (dims as i64))
requires initialized(data, (rows as i64) * (dims as i64))
requires valid(chosen, samples)
requires initialized(chosen, samples)
requires valid(centers, (k as i64) * (dims as i64))
requires initialized(centers, (k as i64) * (dims as i64))
ensures !frees(data)
ensures !frees(centers)
{
  let width = i64::from(dims);
  let mut objective: f64 = 0.0;
  for position in 0..samples {
    let row: i64 = unsafe { sample_row(chosen, samples, position, rows) };
    let point: *const f32 = offset(data, row * width);
    let center: i32 = unsafe { nearest(point, centers, k, dims, metric) };
    objective += unsafe { centroid_distance(point, centers, center, k, dims, metric) };
  }
  return objective;
}

// Writes the index of the nearest of the k centers for each of the rows of
// data to out.
unsafe fn assign_rows(data: *const f32, rows: i32, dims: i32,
centers: *const f32, k: i32, metric: &DistanceMetric, out: *mut i32) -> void
requires k > 0 && dims > 0 && rows > 0
requires valid(data, (rows as i64) * (dims as i64))
requires initialized(data, (rows as i64) * (dims as i64))
requires valid(centers, (k as i64) * (dims as i64))
requires initialized(centers, (k as i64) * (dims as i64))
requires valid(out, rows)
{
  let width = i64::from(dims);
  for row in 0..rows {
    let r: i64 = i64::from(row);
    let point: *const f32 = offset(data, r * width);
    let center: i32 = unsafe { nearest(point, centers, k, dims, metric) };
    unsafe { out[row] = center; }
  }
}

// The result of one restart. status is 1 for float32 centroid-sum overflow.
struct RestartResult {
  status: i32,
  objective: f64,
}

// Runs one restart of Lloyd's algorithm and leaves its centroids in current.
// data holds rows row-major vectors. Sample position p is row chosen[p].
unsafe fn run_restart(data: *const f32, rows: i32, dims: i32, k: i32,
samples: i32, chosen: *const i64, restart: i32, iterations: i32,
metric: &DistanceMetric, spherical: bool,
current: *mut f32, sums: *mut f32, counts: *mut i32) -> RestartResult
requires k > 0 && dims > 0 && rows > 0
requires samples > 0 && restart >= 0
requires valid(data, (rows as i64) * (dims as i64))
requires initialized(data, (rows as i64) * (dims as i64))
requires valid(chosen, samples)
requires initialized(chosen, samples)
requires valid(current, (k as i64) * (dims as i64))
requires valid(sums, (k as i64) * (dims as i64))
requires valid(counts, k)
ensures initialized(current, (k as i64) * (dims as i64))
ensures !frees(data)
ensures !frees(chosen)
ensures !frees(current)
ensures !frees(sums)
ensures !frees(counts)
{
  let count = i64::from(k);
  let width = i64::from(dims);

  let mut seeded = 0i64;
  while seeded < count
  invariant seeded >= 0i64 && seeded <= count
  invariant initialized(current, seeded * width) {
    let position: i32 = spaced_position(seeded, k, samples, i64::from(restart) * 104729);
    let row: i64 = unsafe { sample_row(chosen, samples, position, rows) };
    let centroid: *mut f32 = offset_mut(current, seeded * width);
    // Trusted: the header requires current and data to be separate buffers,
    // but Vx's !overlaps takes one length for both, and the two buffers have
    // different lengths. See docs/vx_usage_review_2026-11-08.md, B2.
    unsafe { copy_vector(centroid, offset(data, row * width), width); }
    if spherical {
      unsafe { normalize(centroid, dims); }
    }
    seeded = seeded + 1i64;
  }

  for iteration in 0..iterations
  invariant initialized(current, (k as i64) * (dims as i64)) {
    unsafe { zero_counts(counts, k); }
    unsafe { zero_sums(sums, count * width); }

    for position in 0..samples {
      let row: i64 = unsafe { sample_row(chosen, samples, position, rows) };
      let point: *const f32 = offset(data, row * width);
      let center: i32 = unsafe { nearest(point, current as *const f32, k, dims, metric) };
      let accumulation: i32 = unsafe {
        accumulate_point(point, sums, counts, center, k, dims)
      };
      if accumulation != 0 {
        return RestartResult { status: accumulation, objective: 0.0 };
      }
    }

    let mut updated = 0i64;
    while updated < count invariant updated >= 0i64 && updated <= count {
      let cluster: i32 = unsafe { counts[updated] };
      let centroid: *mut f32 = offset_mut(current, updated * width);
      if cluster == 0 {
        let position: i32 = ((updated + i64::from(iteration)) % i64::from(samples)) as i32;
        let row: i64 = unsafe { sample_row(chosen, samples, position, rows) };
        // Trusted for the same reason as the copy that seeds current.
        unsafe { copy_vector(centroid, offset(data, row * width), width); }
      } else {
        for d in 0i64..width {
          let index: i64 = buffer_index(updated, count, width, d);
          unsafe { current[index] = sums[index] / (cluster as f32); }
        }
      }
      if spherical {
        unsafe { normalize(centroid, dims); }
      }
      updated = updated + 1i64;
    }
  }

  let objective: f64 = unsafe { sample_objective(data, rows, dims, k, samples,
    chosen, metric, current as *const f32) };
  return RestartResult { status: 0, objective: objective };
}

// Trains k centroids from samples of the rows row-major vectors at data, and
// writes them to output. chosen and table are sampler scratch.
unsafe fn train(data: *const f32, rows: i32, dims: i32, k: i32, samples: i32,
iterations: i32, restarts: i32, metric: &DistanceMetric, spherical: bool,
seed: i32, output: *mut f32, current: *mut f32, sums: *mut f32, counts: *mut i32,
chosen: *mut i64, table: *mut i64, slots: i64) -> i32
requires k > 0 && dims > 0 && rows >= k
requires samples > 0 && samples <= rows && restarts > 0 && seed >= 0
requires slots > (samples as i64)
requires valid(data, (rows as i64) * (dims as i64))
requires initialized(data, (rows as i64) * (dims as i64))
requires valid(output, (k as i64) * (dims as i64))
requires valid(current, (k as i64) * (dims as i64))
requires valid(sums, (k as i64) * (dims as i64))
requires valid(counts, k)
requires valid(chosen, samples)
requires valid(table, slots)
requires !overlaps(output, current, (k as i64) * (dims as i64))
{
  let count = i64::from(k);
  let width = i64::from(dims);
  let size = count * width;
  unsafe { choose_rows(rows as i64, samples as i64, seed as u64, table, slots, chosen); }
  let sample: *const i64 = chosen as *const i64;

  // The first restart always gives the best centroids so far.
  let first = unsafe { run_restart(data, rows, dims, k, samples, sample, 0,
    iterations, metric, spherical, current, sums, counts) };
  if first.status != 0 {
    return first.status;
  }
  unsafe { copy_vector(output, current as *const f32, size); }
  let mut best_objective = first.objective;
  for restart in 1..restarts {
    let result: RestartResult = unsafe { run_restart(data, rows, dims, k, samples, sample,
      restart, iterations, metric, spherical, current, sums, counts) };
    if result.status != 0 {
      return result.status;
    }
    if result.objective < best_objective {
      best_objective = result.objective;
      unsafe { copy_vector(output, current as *const f32, size); }
    }
  }
  return 0;
}

// The number of sampled rows for k centroids: k * sampling_factor, at most rows.
fn sample_count(rows: i32, k: i32, sampling_factor: i32) -> i32
requires rows > 0 && k > 0 && sampling_factor > 0
ensures return > 0 && return <= rows
{
  let requested = i64::from(k) * i64::from(sampling_factor);
  if requested < i64::from(rows) {
    return requested as i32;
  }
  return rows;
}

// metric: 0=l2, 1=inner product, 2=cosine. root_count=0 means flat clustering.
// nodes contains the zero root, optional root centroids, then leaf centroids.
// Returns 1 for invalid arguments or float32 centroid-sum overflow.
// This is the C boundary. Its unsafe calls trust the capacities and the
// disjoint buffers that include/vxvector_kmeans.h requires of the caller.
pub fn vxvector_kmeans_v2(points: *const f32, rows: i32, dims: i32,
root_count: i32, leaf_count: i32, sampling_factor: i32,
iterations: i32, restarts: i32, metric: i32,
spherical: i32, seed: i32,
nodes: *mut f32, parents: *mut i32,
assignments: *mut i32, current: *mut f32,
sums: *mut f32, counts: *mut i32,
sample_rows: *mut i64, sample_table: *mut i64) -> i32 {
  if points == null<f32>() || nodes == null_mut<f32>() ||
  parents == null_mut<i32>() || assignments == null_mut<i32>() ||
  current == null_mut<f32>() || sums == null_mut<f32>() ||
  counts == null_mut<i32>() {
    return 1;
  }
  if sample_rows == null_mut<i64>() || sample_table == null_mut<i64>() {
    return 1;
  }
  // Pointer comparisons stay out of this condition, so the prover keeps
  // its facts for the calls below.
  if leaf_count <= 0 || dims <= 0 ||
  rows <= 0 || leaf_count > rows ||
  root_count < 0 || root_count > leaf_count ||
  i64::from(root_count) + i64::from(leaf_count) >= 2147483647 ||
  sampling_factor <= 0 || iterations <= 0 ||
  restarts <= 0 || metric < 0 || metric > 2 || seed < 0 {
    return 1;
  }
  for row in 0..rows {
    for d in 0..dims {
      let value = unsafe {
        points[i64::from(row) * i64::from(dims) + i64::from(d)]
      };
      if !value.is_finite() {
        return 1;
      }
    }
  }
  for d in 0..dims {
    unsafe { nodes[d] = 0.0; }
  }
  unsafe { parents[0] = -1; }

  let distance_metric = match metric {
    0 => {
      DistanceMetric::L2
    },
    1 => {
      DistanceMetric::InnerProduct
    },
    _ => {
      DistanceMetric::Cosine
    },
  };
  let is_spherical = spherical != 0;
  let width = i64::from(dims);
  let roots = offset_mut(nodes, width);
  let leaves = offset_mut(nodes, i64::from(1 + root_count) * width);
  let leaf_samples = sample_count(rows, leaf_count, sampling_factor);
  let leaf_slots = table_slots(leaf_samples as i64);
  let leaf_status = unsafe { train(points, rows, dims, leaf_count, leaf_samples,
    iterations, restarts, &distance_metric, is_spherical, seed, leaves,
    current, sums, counts, sample_rows, sample_table, leaf_slots) };
  if leaf_status != 0 {
    return leaf_status;
  }
  unsafe { assign_rows(points, rows, dims, leaves as *const f32, leaf_count,
    &distance_metric, assignments); }

  let leaf_parents = offset_mut(parents, i64::from(1 + root_count));
  if root_count == 0 {
    for leaf in 0..leaf_count {
      unsafe { leaf_parents[leaf] = 0; }
    }
    return 0;
  }

  // Root training samples at most leaf_count <= leaf_samples rows, so the
  // sampler scratch for the leaves is large enough.
  let root_samples = sample_count(leaf_count, root_count, sampling_factor);
  let root_slots = table_slots(root_samples as i64);
  let root_status = unsafe { train(leaves as *const f32, leaf_count, dims, root_count,
    root_samples, iterations, restarts, &distance_metric, is_spherical,
    (seed % 2147483646) + 1, roots, current, sums, counts,
    sample_rows, sample_table, root_slots) };
  if root_status != 0 {
    return root_status;
  }
  for root in 0..root_count {
    unsafe { parents[1 + root] = 0; }
  }
  // A leaf's parent is the node ID of its nearest root: 1 + the root index.
  unsafe { assign_rows(leaves as *const f32, leaf_count, dims, roots as *const f32,
    root_count, &distance_metric, leaf_parents); }
  for leaf in 0..leaf_count {
    unsafe { leaf_parents[leaf] = leaf_parents[leaf] + 1; }
  }
  return 0;
}

// ---------------------------------------------------------------------------
// The streaming data path. src/data_path.c allocates its buffers, supplies
// the clock, and turns each outcome below into a status code and a message.

// These structures mirror include/vxvector_data_path.h.
struct CpuOptions {
  row_count: u64,
  memory_budget_bytes: u64,
  dims: i32,
  root_count: i32,
  leaf_count: i32,
  sampling_factor: i32,
  batch_size: i32,
  iterations: i32,
  restarts: i32,
  metric: i32,
  spherical: i32,
  seed: i32,
}

struct CpuPlan {
  sample_count: u64,
  batch_rows: u64,
  node_count: u64,
  hash_slots: u64,
  buffer_bytes: u64,
}

struct InputRow {
  values: *const f32,
  dims: u32,
  kind: i32,
}

// This mirrors struct vxvector_cpu_buffers in src/data_path.c.
struct CpuBuffers {
  sample: *mut f32,
  sample_rows: *mut i64,
  nodes: *mut f32,
  parents: *mut i32,
  assignments: *mut i32,
  batch: *mut f32,
  current: *mut f32,
  sums: *mut f32,
  counts: *mut i32,
  positions: *mut i64,
  table: *mut i64,
  timings: *mut f64,
}

// The outcomes of the data path. src/data_path.c keeps the same list.
const DATA_OK: i32 = 0;
const DATA_INVALID_OPTION: i32 = 1;
const DATA_SAMPLE_OVERFLOW: i32 = 2;
const DATA_BUFFER_OVERFLOW: i32 = 3;
const DATA_BUDGET: i32 = 4;
const DATA_SOURCE_SHORT: i32 = 5;
const DATA_SOURCE_LONG: i32 = 6;
const DATA_SOURCE_FAILED: i32 = 7;
const DATA_INVALID_ROW: i32 = 8;
const DATA_NONFINITE_ROW: i32 = 9;
const DATA_KMEANS_REJECTED: i32 = 10;
const DATA_NONFINITE_CENTROID: i32 = 11;
const DATA_INVALID_BACKEND: i32 = 12;
const DATA_GPU_REQUIRED: i32 = 13;
const DATA_GPU_FAILED: i32 = 14;

// The largest allocation that size_t and ptrdiff_t both hold on the 64-bit
// targets, and the total that marks a size beyond it.
const ALLOCATION_LIMIT: u64 = 9223372036854775807u64;
const TOO_LARGE: u64 = 18446744073709551615u64;

// total plus count elements of width bytes, or TOO_LARGE when the sum would
// exceed ALLOCATION_LIMIT. This is tested, not proved: the prover ignores `/`
// and cannot use these u64 constants. tests/test_data_path.py covers both
// overflow results.
fn add_buffer(total: u64, count: u64, width: u64) -> u64
requires width > 0
{
  if count > ALLOCATION_LIMIT / width {
    return TOO_LARGE;
  }
  if total > ALLOCATION_LIMIT - count * width {
    return TOO_LARGE;
  }
  return total + count * width;
}

// Whether the options describe a request that the data path can run.
fn valid_options(o: &CpuOptions) -> bool {
  if o.row_count == 0 || o.row_count > ALLOCATION_LIMIT {
    return false;
  }
  if o.dims <= 0 || o.root_count < 0 || o.leaf_count <= 0 || o.root_count > o.leaf_count {
    return false;
  }
  if o.leaf_count as u64 > o.row_count {
    return false;
  }
  if i64::from(o.root_count) + i64::from(o.leaf_count) >= 2147483647 {
    return false;
  }
  if o.sampling_factor <= 0 || o.batch_size <= 0 || o.iterations <= 0 || o.restarts <= 0 {
    return false;
  }
  if o.metric < 0 || o.metric > 2 || (o.spherical != 0 && o.spherical != 1) || o.seed < 0 {
    return false;
  }
  return true;
}

// Checks the options and sizes every heap buffer of the data path, without
// allocation. plan holds zeros unless the sizes are known. After a budget
// failure it holds the sizes.
pub fn vxvector_plan_cpu_reason_v1(options: *const CpuOptions, plan: *mut CpuPlan) -> i32 {
  if plan == null_mut<CpuPlan>() {
    return DATA_INVALID_OPTION;
  }
  let zero: u64 = 0;
  unsafe {
    plan[0] = CpuPlan { sample_count: zero, batch_rows: zero, node_count: zero,
      hash_slots: zero, buffer_bytes: zero };
  }
  if options == null<CpuOptions>() {
    return DATA_INVALID_OPTION;
  }
  let o: CpuOptions = unsafe { options[0] };
  if !valid_options(&o) {
    return DATA_INVALID_OPTION;
  }
  let requested = (o.leaf_count as u64) * (o.sampling_factor as u64);
  let mut samples = o.row_count;
  if requested < o.row_count {
    samples = requested;
  }
  if samples > 2147483647u64 {
    return DATA_SAMPLE_OVERFLOW;
  }
  let sample_rows = samples as i64;
  if sample_rows <= 0i64 {
    return DATA_INVALID_OPTION;
  }
  let mut batch_rows = o.row_count;
  if (o.batch_size as u64) < o.row_count {
    batch_rows = o.batch_size as u64;
  }
  let one: u64 = 1;
  let node_count = one + (o.root_count as u64) + (o.leaf_count as u64);
  let slots = table_slots(sample_rows) as u64;
  let dims = o.dims as u64;
  let leaves = o.leaf_count as u64;
  let mut bytes: u64 = 0;
  bytes = add_buffer(bytes, samples * dims, 4u64);
  bytes = add_buffer(bytes, batch_rows * dims, 4u64);
  bytes = add_buffer(bytes, node_count * dims, 4u64);
  bytes = add_buffer(bytes, node_count, 4u64);
  bytes = add_buffer(bytes, samples, 4u64);
  bytes = add_buffer(bytes, leaves * dims, 4u64);
  bytes = add_buffer(bytes, leaves * dims, 4u64);
  bytes = add_buffer(bytes, leaves, 4u64);
  bytes = add_buffer(bytes, samples, 8u64);
  bytes = add_buffer(bytes, samples, 16u64);
  bytes = add_buffer(bytes, slots, 8u64);
  if bytes == TOO_LARGE {
    return DATA_BUFFER_OVERFLOW;
  }
  unsafe {
    plan[0] = CpuPlan { sample_count: samples, batch_rows: batch_rows, node_count: node_count,
      hash_slots: slots, buffer_bytes: bytes };
  }
  if bytes > o.memory_budget_bytes {
    return DATA_BUDGET;
  }
  return DATA_OK;
}

// Pairs each sampled row with its place in the sample: positions holds
// (row, destination) for destination 0..count.
unsafe fn pair_positions(chosen: *const i64, count: i64, positions: *mut i64) -> void
requires count > 0 && count <= 2147483647
requires valid(chosen, count)
requires initialized(chosen, count)
requires valid(positions, 2i64 * count)
ensures initialized(positions, 2i64 * count)
ensures !frees(positions)
{
  for i in 0i64..count invariant initialized(positions, 2i64 * i) {
    unsafe { positions[2i64 * i] = chosen[i]; }
    unsafe { positions[2i64 * i + 1i64] = i; }
  }
}

// Swaps pairs a and b of positions.
unsafe fn swap_pairs(positions: *mut i64, count: i64, a: i64, b: i64) -> void
requires count > 0 && a >= 0 && a < count && b >= 0 && b < count
requires valid(positions, 2i64 * count)
requires initialized(positions, 2i64 * count)
ensures !frees(positions)
{
  let row: i64 = unsafe { positions[2i64 * a] };
  let destination: i64 = unsafe { positions[2i64 * a + 1i64] };
  unsafe { positions[2i64 * a] = positions[2i64 * b]; }
  unsafe { positions[2i64 * a + 1i64] = positions[2i64 * b + 1i64]; }
  unsafe { positions[2i64 * b] = row; }
  unsafe { positions[2i64 * b + 1i64] = destination; }
}

// Restores the max-heap order by row below pair root, in the first size pairs.
unsafe fn sift_down(positions: *mut i64, count: i64, size: i64, start: i64) -> void
requires count > 0 && size > 0 && size <= count && start >= 0 && start < size
requires valid(positions, 2i64 * count)
requires initialized(positions, 2i64 * count)
ensures !frees(positions)
{
  let mut root = start;
  // child and right are declared outside the loop: Vx drops the facts about
  // root = child when the scope of child ends.
  let mut child = start;
  let mut right = start;
  while 2i64 * root + 1i64 < size invariant root >= 0 && root < size {
    child = 2i64 * root + 1i64;
    right = child + 1i64;
    if right < size {
      if unsafe { positions[2i64 * child] } < unsafe { positions[2i64 * right] } {
        child = right;
      }
    }
    if unsafe { positions[2i64 * root] } >= unsafe { positions[2i64 * child] } {
      return;
    }
    unsafe { swap_pairs(positions, count, root, child); }
    root = child;
  }
}

// Heapsort by row. It needs no memory beyond the budgeted pairs.
unsafe fn sort_positions(positions: *mut i64, count: i64) -> void
requires count > 0
requires valid(positions, 2i64 * count)
requires initialized(positions, 2i64 * count)
ensures !frees(positions)
{
  // Pairs without children need no sifting. Starting at the last pair
  // avoids a division, which the prover does not model.
  let mut start = count;
  while start > 0i64 invariant start >= 0i64 && start <= count {
    start = start - 1i64;
    unsafe { sift_down(positions, count, count, start); }
  }
  let mut end = count - 1i64;
  while end > 0i64 invariant end >= 0i64 && end < count {
    unsafe { swap_pairs(positions, count, 0i64, end); }
    unsafe { sift_down(positions, count, end, 0i64); }
    end = end - 1i64;
  }
}

// Reads rows source rows into batch through the C reader, and checks each.
unsafe fn read_batch(next: fn(*mut u8, *mut InputRow) -> i32, context: *mut u8,
row: *mut InputRow, batch: *mut f32, rows: i32, dims: i32) -> i32
requires rows > 0 && dims > 0
requires valid(row, 1)
requires valid(batch, (rows as i64) * (dims as i64))
ensures !frees(batch)
{
  let count = i64::from(rows);
  let width = i64::from(dims);
  for r in 0i64..count {
    let status = next(context, row);
    if status == 0 {
      return DATA_SOURCE_SHORT;
    }
    if status != 1 {
      return DATA_SOURCE_FAILED;
    }
    let input: InputRow = unsafe { row[0] };
    if input.values == null<f32>() {
      return DATA_INVALID_ROW;
    }
    if input.kind != 0 || i64::from(input.dims) != width {
      return DATA_INVALID_ROW;
    }
    let values: *const f32 = input.values;
    for d in 0i64..width {
      // Trusted: the reader promises dims values that stay valid until its
      // next call.
      let value: f32 = unsafe { values[d] };
      if !value.is_finite() {
        return DATA_NONFINITE_ROW;
      }
      let index = buffer_index(r, count, width, d);
      unsafe { batch[index] = value; }
    }
  }
  return DATA_OK;
}

// Copies the sampled rows of a batch to their places in sample. The batch
// holds rows source rows from row base on. positions holds count
// (row, destination) pairs sorted by row, of which the first first are
// copied. Returns the number copied after this batch.
unsafe fn gather(batch: *const f32, base: i64, rows: i32, dims: i32,
positions: *const i64, count: i64, first: i64, sample: *mut f32) -> i64
requires rows > 0 && dims > 0 && count > 0 && count <= 2147483647
requires first >= 0 && first <= count
requires valid(batch, (rows as i64) * (dims as i64))
requires initialized(batch, (rows as i64) * (dims as i64))
requires valid(positions, 2i64 * count)
requires initialized(positions, 2i64 * count)
requires valid(sample, count * (dims as i64))
ensures return >= 0i64 && return <= count
ensures !frees(sample)
{
  let width = i64::from(dims);
  let height = i64::from(rows);
  let mut selected = first;
  while selected < count invariant selected >= 0 && selected <= count {
    let source: i64 = unsafe { positions[2i64 * selected] } - base;
    let destination: i64 = unsafe { positions[2i64 * selected + 1i64] };
    // Earlier batches took every row before base, and select_rows chose
    // destinations below count. The prover cannot see what memory holds.
    if source < 0i64 || source >= height || destination < 0i64 || destination >= count {
      return selected;
    }
    for d in 0i64..width {
      let from = buffer_index(source, height, width, d);
      let to = buffer_index(destination, count, width, d);
      unsafe { sample[to] = batch[from]; }
    }
    selected = selected + 1i64;
  }
  return selected;
}

// Whether every one of length values is finite.
unsafe fn all_finite(values: *const f32, length: i64) -> bool
requires valid(values, length)
requires initialized(values, length)
{
  for i in 0i64..length {
    let value: f32 = unsafe { values[i] };
    if !value.is_finite() {
      return false;
    }
  }
  return true;
}

// Zero seconds. A float literal in a function with a loop invariant reaches
// the prover and crashes it, as in positive (vx-lang/Vx#3145). A call keeps
// it out of the facts.
fn no_seconds() -> f64 {
  return 0.0;
}

// Chooses the sample, reads and checks every source row, collects the sampled
// rows, and trains on them. options must pass vxvector_plan_cpu_reason_v1,
// which wrote plan. buffers holds the capacities that plan states. row is
// storage for the reader. timings receives read, sample and clustering seconds.
// This is a C boundary. Its unsafe calls trust those capacities.
pub fn vxvector_run_reason_v2(options: *const CpuOptions, plan: *const CpuPlan,
next: fn(*mut u8, *mut InputRow) -> i32, context: *mut u8, row: *mut InputRow,
clock: fn() -> f64, buffers: *const CpuBuffers, backend: i32,
gpu_train: fn(*const f32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32,
  *mut f32, *mut i32, *mut i32, *mut f32, *mut f32, *mut i32, *mut i64, *mut i64) -> i32) -> i32 {
  let o: CpuOptions = unsafe { options[0] };
  let p: CpuPlan = unsafe { plan[0] };
  let b: CpuBuffers = unsafe { buffers[0] };
  if !valid_options(&o) {
    return DATA_INVALID_OPTION;
  }
  if backend != BACKEND_CPU && backend != BACKEND_GPU {
    return DATA_INVALID_BACKEND;
  }
  // The plan states these. The checks give the prover the facts that the
  // calls below require.
  let rows: i64 = o.row_count as i64;
  let count: i64 = p.sample_count as i64;
  let slots: i64 = p.hash_slots as i64;
  let batch_rows: i64 = p.batch_rows as i64;
  let dims: i32 = o.dims;
  let width: i64 = dims as i64;
  if count <= 0i64 || count > 2147483647i64 || count > rows || slots <= count {
    return DATA_INVALID_OPTION;
  }
  if batch_rows <= 0i64 || batch_rows > 2147483647i64 || dims <= 0 {
    return DATA_INVALID_OPTION;
  }

  // Each buffer is a local. A contract can name a local argument, but not a
  // field of b.
  let sample: *mut f32 = b.sample;
  let batch: *mut f32 = b.batch;
  let positions: *mut i64 = b.positions;
  let mut start = clock();
  unsafe { choose_rows(rows, count, o.seed as u64, b.table, slots, b.sample_rows); }
  unsafe { pair_positions(b.sample_rows as *const i64, count, b.positions); }
  unsafe { sort_positions(b.positions, count); }
  let mut sample_seconds = clock() - start;
  let mut read_seconds: f64 = no_seconds();

  let mut selected = 0i64;
  let mut base = 0i64;
  // height is declared outside the loop for the same reason as child in
  // sift_down.
  let mut height: i64 = batch_rows;
  while base < rows
  invariant base >= 0i64
  invariant selected >= 0i64 && selected <= count {
    height = batch_rows;
    if rows - base < height {
      height = rows - base;
    }
    start = clock();
    let status = unsafe { read_batch(next, context, row, b.batch, height as i32, dims) };
    read_seconds += clock() - start;
    if status != DATA_OK {
      return status;
    }
    start = clock();
    selected = unsafe { gather(batch as *const f32, base, height as i32, dims,
      positions as *const i64, count, selected, sample) };
    // gather ensures this, but Vx drops the ensures of a call whose arguments
    // it cannot model, such as a pointer cast, when the result is assigned
    // rather than bound by `let` (vx-lang/Vx#3040). A `let` inside the loop
    // would not help: its facts end with its scope.
    if selected < 0i64 || selected > count {
      return DATA_INVALID_OPTION;
    }
    sample_seconds += clock() - start;
    base = base + height;
  }
  start = clock();
  let extra = next(context, row);
  read_seconds += clock() - start;
  if extra == 1 {
    return DATA_SOURCE_LONG;
  }
  if extra != 0 {
    return DATA_SOURCE_FAILED;
  }
  if selected != count {
    return DATA_INVALID_OPTION;
  }

  // The data path samples already, so the kernel takes every collected row in
  // order. The pairs and the table are free again and serve as its scratch.
  // The GPU trainer takes the same arguments and gives the same layout. It
  // returns 2 when the GPU fails after training starts, which is reported and
  // not run again on the CPU.
  start = clock();
  let mut status = 0;
  if backend == BACKEND_GPU {
    status = gpu_train(b.sample as *const f32, count as i32, o.dims,
      o.root_count, o.leaf_count, o.sampling_factor, o.iterations, o.restarts,
      o.metric, o.spherical, o.seed, b.nodes, b.parents, b.assignments,
      b.current, b.sums, b.counts, b.positions, b.table);
  } else {
    status = vxvector_kmeans_v2(b.sample as *const f32, count as i32, o.dims,
      o.root_count, o.leaf_count, o.sampling_factor, o.iterations, o.restarts,
      o.metric, o.spherical, o.seed, b.nodes, b.parents, b.assignments,
      b.current, b.sums, b.counts, b.positions, b.table);
  }
  let clustering_seconds = clock() - start;
  let timings: *mut f64 = b.timings;
  unsafe { timings[0] = read_seconds; }
  unsafe { timings[1] = sample_seconds; }
  unsafe { timings[2] = clustering_seconds; }
  if status == 2 && backend == BACKEND_GPU {
    return DATA_GPU_FAILED;
  }
  if status != 0 {
    return DATA_KMEANS_REJECTED;
  }
  let node_values = (p.node_count as i64) * width;
  if !unsafe { all_finite(b.nodes as *const f32, node_values) } {
    return DATA_NONFINITE_CENTROID;
  }
  return DATA_OK;
}

// ---------------------------------------------------------------------------
// Backend selection (Step 4 of docs/pg_vxvector.md). src/data_path.c keeps the
// same lists.

const MODE_AUTO: i32 = 0;
const MODE_CPU: i32 = 1;
const MODE_GPU: i32 = 2;

// What the caller found when it looked for the GPU library and a device.
const PROBE_READY: i32 = 0;
const PROBE_NOT_INSTALLED: i32 = 1;
const PROBE_UNAVAILABLE: i32 = 2;

const BACKEND_CPU: i32 = 0;
const BACKEND_GPU: i32 = 1;

const REASON_CPU_REQUESTED: i32 = 0;
const REASON_GPU_SELECTED: i32 = 1;
const REASON_GPU_NOT_INSTALLED: i32 = 2;
const REASON_GPU_UNAVAILABLE: i32 = 3;
const REASON_GPU_METRIC: i32 = 4;
const REASON_GPU_RESTARTS: i32 = 5;
const REASON_GPU_SPHERICAL: i32 = 6;
const REASON_GPU_ROOTS: i32 = 7;
const REASON_GPU_SIZE: i32 = 8;
const REASON_GPU_BUDGET: i32 = 9;

// The page size of the GPU allocator on Apple silicon. vx_metal_alloc gives
// each buffer whole pages.
const GPU_PAGE: u64 = 16384u64;

// The chosen backend, why, and the GPU memory it needs. This mirrors
// struct vxvector_backend_choice in include/vxvector_data_path.h.
struct BackendChoice {
  backend: i32,
  reason: i32,
  gpu_bytes: u64,
}

// total plus one GPU buffer of count elements of width bytes, in whole pages.
fn add_gpu_buffer(total: u64, count: u64, width: u64) -> u64
requires width > 0
{
  let bytes = add_buffer(0u64, count, width);
  if bytes == TOO_LARGE {
    return TOO_LARGE;
  }
  // bytes is at most ALLOCATION_LIMIT, so rounding up cannot wrap.
  let pages = (bytes + GPU_PAGE - 1u64) / GPU_PAGE;
  return add_buffer(total, pages, GPU_PAGE);
}

// The GPU memory that vxvector_gpu_l2_v1 allocates for n samples of dims
// values and k centers: samples, centers, sums and overflow flags, best
// distances and labels, and counts.
fn gpu_bytes(n: u64, k: u64, dims: u64) -> u64 {
  let mut total = add_gpu_buffer(0u64, n * dims, 4u64);
  if total == TOO_LARGE || dims > ALLOCATION_LIMIT / 4u64 || k > ALLOCATION_LIMIT / 4u64 / dims {
    return TOO_LARGE;
  }
  let center_values = k * dims;
  for buffer in 0..3 {
    total = add_gpu_buffer(total, center_values, 4u64);
  }
  total = add_gpu_buffer(total, n, 4u64);
  total = add_gpu_buffer(total, n, 4u64);
  total = add_gpu_buffer(total, k, 4u64);
  return total;
}

// REASON_GPU_SELECTED when the GPU can train this request, or why not.
fn gpu_reason(o: &CpuOptions, p: &CpuPlan, probe: i32) -> i32 {
  if probe == PROBE_NOT_INSTALLED {
    return REASON_GPU_NOT_INSTALLED;
  }
  if probe != PROBE_READY {
    return REASON_GPU_UNAVAILABLE;
  }
  if o.metric != 0 {
    return REASON_GPU_METRIC;
  }
  if o.restarts != 1 {
    return REASON_GPU_RESTARTS;
  }
  if o.spherical != 0 {
    return REASON_GPU_SPHERICAL;
  }
  if o.root_count != 0 {
    return REASON_GPU_ROOTS;
  }
  // The kernels index with i32: n * dims and k + iterations stay below 2^31.
  let n: u64 = p.sample_count;
  let dims: u64 = o.dims as u64;
  if n > 2147483647u64 / dims ||
  (o.leaf_count as i64) + (o.iterations as i64) >= 2147483647i64 {
    return REASON_GPU_SIZE;
  }
  let gpu = gpu_bytes(n, o.leaf_count as u64, dims);
  if gpu == TOO_LARGE || p.buffer_bytes > o.memory_budget_bytes ||
  gpu > o.memory_budget_bytes - p.buffer_bytes {
    return REASON_GPU_BUDGET;
  }
  return REASON_GPU_SELECTED;
}

// Chooses the backend before any row is read or any GPU memory is allocated.
// options must pass vxvector_plan_cpu_reason_v1, which wrote plan. mode is
// MODE_AUTO, MODE_CPU, or MODE_GPU, and probe says whether the caller found
// the GPU library and a device. In MODE_GPU, a request that the GPU cannot
// run returns DATA_GPU_REQUIRED, and choice still gives the reason.
// This is a C boundary.
pub fn vxvector_select_backend_reason_v1(options: *const CpuOptions, plan: *const CpuPlan,
mode: i32, probe: i32, choice: *mut BackendChoice) -> i32 {
  let o: CpuOptions = unsafe { options[0] };
  let p: CpuPlan = unsafe { plan[0] };
  if !valid_options(&o) {
    return DATA_INVALID_OPTION;
  }
  if mode != MODE_AUTO && mode != MODE_CPU && mode != MODE_GPU {
    return DATA_INVALID_BACKEND;
  }
  if mode == MODE_CPU {
    unsafe { choice[0] = BackendChoice { backend: BACKEND_CPU, reason: REASON_CPU_REQUESTED, gpu_bytes: 0u64 }; }
    return DATA_OK;
  }
  let reason = gpu_reason(&o, &p, probe);
  if reason == REASON_GPU_SELECTED {
    let bytes = gpu_bytes(p.sample_count, o.leaf_count as u64, o.dims as u64);
    unsafe { choice[0] = BackendChoice { backend: BACKEND_GPU, reason: reason, gpu_bytes: bytes }; }
    return DATA_OK;
  }
  unsafe { choice[0] = BackendChoice { backend: BACKEND_CPU, reason: reason, gpu_bytes: 0u64 }; }
  if mode == MODE_GPU {
    return DATA_GPU_REQUIRED;
  }
  return DATA_OK;
}
